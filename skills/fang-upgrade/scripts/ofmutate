#!/usr/bin/env python3
# ofmutate <worktree> --test <фильтр> [--base REF] [-p КРЕЙТ]... [--per-hunk] [--dry-run]
#
# Механическая проверка «красное до зелёного» ПОСЛЕ факта: тест уже написан и зелёный,
# и надо доказать, что он покраснеет без патча. Порядок работы это не навязывает —
# оно проверяет результат, а результат проверяем именно потому, что за пять спринтов
# десять тестов оказались тавтологиями (проходили и до патча, и после).
#
# Что делает:
#   1. прогон КАК ЕСТЬ — тест обязан пройти, и обязан быть непустым (см. ниже);
#   2. откат продакшн-ханков патча (тестовые ханки остаются на месте) — тест обязан упасть;
#   3. восстановление дерева.
#
# Почему ханки, а не файлы. В Rust юнит-тесты лежат в ТОМ ЖЕ файле под `#[cfg(test)]`.
# Откат файла целиком снёс бы вместе с патчем и тест, тест перестал бы существовать, и
# «упало» ничего не значило бы. Поэтому патч режется по ханкам: ханк, чей новый диапазон
# строк попадает внутрь модуля `#[cfg(test)]`, считается тестовым и НЕ откатывается.
#
# Пустой прогон — отдельный отказ, а не успех. `cargo test <фильтр>` при опечатке в
# фильтре печатает `test result: ok. 0 passed` и код 0. Именно так выглядит тест-тавтология
# в самой чистой форме: зелено, потому что не запускалось ничего. Поэтому этап 1 требует
# passed >= 1, иначе выход 4.
#
# Различие двух красных, оно важно:
#   RED-ASSERT  — тест собрался и упал на утверждении. Это доказательство: тест смотрит
#                 на поведение, которое ввёл патч.
#   RED-COMPILE — без патча тест не собирается (зовёт функцию, которой ещё нет). Это
#                 слабее: доказано только, что тест ЗНАЕТ о новом API, но не то, что он
#                 проверяет его поведение. Такой тест мог бы вызвать новую функцию и не
#                 проверить результат. Тогда нужен --per-hunk: он откатывает ханки по
#                 одному и показывает, какие из них тест не замечает вовсе.
#
# ── ПРО ИЗОЛЯЦИЮ ЦЕЛИ СБОРКИ ────────────────────────────────────────────────
# Прогон идёт в контейнере на томе цели сборки fang-target-<basename>-, поэтому сборка
# инкрементальная. Одного basename для ВЫБОРА тома мало, и это не теория:
# /root/ofmfix-twinA/twin и /root/ofmfix-twinB/twin — разные деревья с одинаковым
# именем каталога; B, чей тест обязан падать, получил от этого инструмента
# GREEN passed=1 на том же бинаре теста twin-62218c97741a28ad, что собрало A, за 0.07 с
# без единой строки компиляции. Отпечатки cargo завязаны на путь и mtime, а внутри
# контейнера оба дерева монтируются по одному пути /build.
#
# Владение томом закреплено меткой .ofgate-owner ВНУТРИ САМОГО ТОМА — той же самой,
# которую пишет и читает ofgate. Метка описывает том, а не инструмент, поэтому оба
# инструмента делят прогретый том одного дерева и не делят его между разными:
#   · тома нет            → создаём, пишем метку с реальным путём дерева;
#   · метка совпала       → это наш том, идём инкрементально;
#   · метка чужая         → уходим на fang-target-<slug><12 знаков sha256 пути>;
#   · метки нет (том от ofcheck-rs или от старой версии) → НЕ занимаем молча: уходим
#     на том с хэшем пути. Занять безымянный том можно только явно,
#     OFMUTATE_ADOPT_LEGACY_VOL=1, и только зная, какое дерево его набивало.
# Схема имён совпадает с ofgate знак в знак, чтобы прогретый том переиспользовался.

import argparse
import hashlib
import os
import re
import subprocess
import sys
import tempfile
import time

# Тот же порог, что в ofcheck-rs. Переопределяется переменной среды только затем, чтобы
# сам отказ по диску можно было прогнать (иначе это ветка, которая никогда не проверялась).
DISK_MIN_G = int(os.environ.get("OFMUTATE_DISK_MIN_G", "12"))
IMAGE = "rust:1-slim-bookworm"
# Та же метка владельца тома, что у ofgate: она описывает ТОМ, а не
# инструмент, поэтому оба тула делят прогретый том одного дерева.
OWNER_STAMP = ".ofgate-owner"
APT = ("apt-get update -qq >/dev/null 2>&1 && apt-get install -y -qq "
       "pkg-config libssl-dev perl make >/dev/null 2>&1;")


def die(msg, code=2):
    print(f"ofmutate: {msg}", file=sys.stderr)
    sys.exit(code)


def git(wt, *args, check=True):
    r = subprocess.run(["git", "-C", wt, *args],
                       capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)} → {r.returncode}\n{r.stderr.strip()}")
    return r.stdout


def resolve_ref(wt, ref):
    r = subprocess.run(["git", "-C", wt, "rev-parse", "--verify", "--quiet", ref],
                       capture_output=True, text=True)
    return r.returncode == 0


def default_base(wt):
    """Имя ствола не зашивается: раньше здесь стояло literal 'ours', и когда
    ветку удалили (переименование/уборка), инструмент падал на самом первом
    вызове — git rev-parse на несуществующую ветку. Вместо строки — цепочка
    источников, каждый читается из самого git, а не из константы в коде:

      1. OFMUTATE_BASE  — явный override, когда ни один автодетект не подходит;
      2. refs/remotes/origin/HEAD — то, что сам origin считает своей веткой
         по умолчанию (пишется при клоне/`git remote set-head`), без сети;
      3. локальные ветки-кандидаты main/master — не имя ствола этого репозитория
         зашитое как истина, а просто порядок проверки самых частых имён;
         первая существующая побеждает.

    Если ни один источник не сработал — явный отказ со списком того, что
    проверялось, а не тихий выбор наугад."""
    tried = []

    env = os.environ.get("OFMUTATE_BASE")
    if env:
        tried.append(f"OFMUTATE_BASE={env}")
        if resolve_ref(wt, env):
            return env

    r = subprocess.run(["git", "-C", wt, "symbolic-ref", "-q",
                        "refs/remotes/origin/HEAD"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        origin_head = r.stdout.strip().replace("refs/remotes/", "", 1)
        tried.append(f"refs/remotes/origin/HEAD → {origin_head}")
        if resolve_ref(wt, origin_head):
            return origin_head

    for cand in ("main", "master"):
        tried.append(f"локальная ветка {cand}")
        if resolve_ref(wt, cand):
            return cand

    die("не удалось определить базу автоматически, задай --base или "
        "OFMUTATE_BASE явно. Проверено и не сработало:\n  - "
        + "\n  - ".join(tried), 2)


def free_gb():
    r = subprocess.run(["df", "-BG", "--output=avail", "/"],
                       capture_output=True, text=True)
    return int(re.sub(r"\D", "", r.stdout.strip().splitlines()[-1]) or 0)


def volume_slug(wt):
    """Имя тома ровно как его строит ofcheck-rs: basename, затем tr -c над
    выводом basename — а тот выводит ещё и \\n, который tr превращает в '-'."""
    base = os.path.basename(os.path.normpath(wt)) + "\n"
    return "".join(c if re.match(r"[a-zA-Z0-9_.-]", c) else "-" for c in base)


def path_hash(wt):
    """12 знаков sha256 пути дерева — ровно как их берёт ofgate:
    `printf '%s' "$WT" | sha256sum | cut -c1-12`."""
    return hashlib.sha256(wt.encode()).hexdigest()[:12]


def vol_exists(vol):
    return subprocess.run(["docker", "volume", "inspect", vol],
                          capture_output=True).returncode == 0


def vol_owner(vol):
    """Записанный владелец тома, или None, если метки нет. Читается ИЗ КОНТЕЙНЕРА:
    каталог тома на хосте может быть недоступен непривилегированному вызову, а с
    самим томом инструмент работает всё равно только через docker."""
    r = subprocess.run(
        ["docker", "run", "--rm", "-v", f"{vol}:/target", IMAGE,
         "sh", "-c", f"cat /target/{OWNER_STAMP} 2>/dev/null || true"],
        capture_output=True, text=True)
    owner = r.stdout.strip().splitlines()
    return owner[0] if owner else None


def stamp_owner(vol, wt):
    subprocess.run(
        ["docker", "run", "--rm", "-v", f"{vol}:/target", IMAGE,
         "sh", "-c", f"printf '%s\\n' \"$1\" > /target/{OWNER_STAMP}",
         "sh", wt],
        capture_output=True)


def target_volume(wt):
    """Том цели сборки, выбранный по ВЛАДЕЛЬЦУ, а не по имени каталога.

    Возвращает (имя тома, пояснение или None). Выходит с кодом 3 (отказ
    инструмента), если даже том с хэшем пути занят чужим деревом."""
    slug = volume_slug(wt)
    tgt = f"fang-target-{slug}"
    hashed = f"fang-target-{slug}{path_hash(wt)}"
    note = None
    if vol_exists(tgt):
        owner = vol_owner(tgt)
        if owner is None:
            if os.environ.get("OFMUTATE_ADOPT_LEGACY_VOL") == "1":
                note = f"том {tgt} без метки владельца занят по OFMUTATE_ADOPT_LEGACY_VOL=1"
            else:
                note = (f"том {tgt} существует без метки владельца — он мог быть набит "
                        f"ЧУЖИМ деревом с тем же именем каталога, молча его не занимаю; "
                        f"иду на {hashed} (первая сборка с нуля). Если том набивало "
                        f"именно {wt} — OFMUTATE_ADOPT_LEGACY_VOL=1")
                tgt = hashed
        elif owner != wt:
            note = f"том fang-target-{slug} принадлежит {owner}; беру {hashed}"
            tgt = hashed
    if tgt == hashed and vol_exists(hashed):
        owner2 = vol_owner(hashed)
        if owner2 is not None and owner2 != wt:
            die(f"том {hashed} принадлежит {owner2}, а не {wt}. Это ОТКАЗ "
                f"ИНСТРУМЕНТА, не дефект патча. Освободи: docker volume rm {hashed}", 3)
    return tgt, note


def test_module_ranges(text):
    """Диапазоны строк (1-based, включительно) модулей `#[cfg(test)]` в тексте файла.
    Скобки считаются грубо — построчно, без разбора строковых литералов; для
    `mod tests { ... }` этого достаточно, а промах виден в инвентаре ханков,
    который печатается до любого действия."""
    lines = text.splitlines()
    ranges = []
    i = 0
    while i < len(lines):
        if re.match(r"\s*#\[cfg\(test\)\]", lines[i]):
            # ищем открывающую скобку модуля
            j = i
            while j < len(lines) and "{" not in lines[j]:
                j += 1
            if j >= len(lines):
                ranges.append((i + 1, len(lines)))
                break
            depth = 0
            k = j
            while k < len(lines):
                depth += lines[k].count("{") - lines[k].count("}")
                if depth <= 0:
                    break
                k += 1
            end = min(k, len(lines) - 1) + 1
            ranges.append((i + 1, end))
            i = end
        else:
            i += 1
    return ranges


HUNK_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")


def split_hunks(wt, base, head):
    """[(файл, индекс-ханка, новая-строка-начала, тестовый?, текст-ханка)] по всему патчу."""
    files = [f for f in git(wt, "diff", "--name-only",
                            f"{base}...{head}").splitlines() if f]
    out = []
    for f in files:
        diff = git(wt, "diff", f"{base}...{head}", "--", f)
        if not diff.strip():
            continue
        header, *rest = re.split(r"(?m)^(?=@@ )", diff, maxsplit=1)
        if not rest:
            continue
        ranges = []
        if f.endswith(".rs"):
            try:
                ranges = test_module_ranges(git(wt, "show", f"{head}:{f}"))
            except SystemExit:
                ranges = []
        hunks = re.split(r"(?m)^(?=@@ )", rest[0])
        for n, h in enumerate([x for x in hunks if x.strip()], 1):
            m = HUNK_RE.match(h)
            if not m:
                continue
            start = int(m.group(1))
            span = int(m.group(2) or 1)
            mid = start + span // 2
            is_test = any(a <= mid <= b for a, b in ranges)
            out.append({"file": f, "n": n, "start": start, "span": span,
                        "test": is_test, "text": header + h, "diff_header": header})
    return out


def run_tests(wt, crates, filt, label, logdir, tgt=None):
    if tgt is None:
        tgt, note = target_volume(wt)
        if note:
            print(f"# ofmutate: {note}", file=sys.stderr)
    subprocess.run(["docker", "volume", "create", tgt],
                   capture_output=True, check=True)
    subprocess.run(["docker", "volume", "create", "fang-cargo-registry"],
                   capture_output=True, check=True)
    stamp_owner(tgt, wt)
    pargs = " ".join(f"-p {c}" for c in crates) or "--workspace"
    cmd = f"{APT} cargo test {pargs} {filt}".strip()
    t0 = time.time()
    r = subprocess.run(
        ["docker", "run", "--rm",
         "-v", f"{wt}:/build:ro",
         "-v", f"{tgt}:/target",
         "-v", "fang-cargo-registry:/usr/local/cargo/registry",
         "-w", "/build",
         "-e", "CARGO_TARGET_DIR=/target",
         "-e", "CARGO_TERM_COLOR=never",
         IMAGE, "sh", "-c", cmd],
        capture_output=True, text=True)
    out = r.stdout + r.stderr
    log = os.path.join(logdir, f"{label}.log")
    with open(log, "w") as fh:
        fh.write(cmd + "\n\n" + out)
    passed = sum(int(m) for m in re.findall(r"(\d+) passed", out))
    failed = sum(int(m) for m in re.findall(r"(\d+) failed", out))
    if re.search(r"could not compile|^error\[E\d+\]", out, re.M):
        verdict = "RED-COMPILE"
    elif "test result: FAILED" in out or failed > 0 or "panicked at" in out:
        verdict = "RED-ASSERT"
    elif "test result: ok" in out:
        verdict = "GREEN"
    else:
        verdict = "UNKNOWN"
    return {"verdict": verdict, "passed": passed, "failed": failed,
            "log": log, "secs": int(time.time() - t0), "out": out,
            "rc": r.returncode}


def show(res, label):
    print(f"  {label}: {res['verdict']}  passed={res['passed']} "
          f"failed={res['failed']}  {res['secs']}s  → {res['log']}")


def apply_reverse(wt, hunks, patchdir, tag):
    """Откатить перечисленные ханки в рабочем дереве. Возвращает путь к патчу."""
    path = os.path.join(patchdir, f"{tag}.patch")
    with open(path, "w") as fh:
        by_file = {}
        for h in hunks:
            by_file.setdefault(h["file"], []).append(h)
        for f, hs in by_file.items():
            fh.write(hs[0]["diff_header"])
            for h in hs:
                fh.write(h["text"][len(h["diff_header"]):])
    r = subprocess.run(["git", "-C", wt, "apply", "--reverse", "--verbose", path],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"откат ханков не применился, дерево не тронуто:\n{r.stderr.strip()}", 5)
    return path


def restore(wt, files):
    subprocess.run(["git", "-C", wt, "checkout", "HEAD", "--", *files],
                   capture_output=True, check=False)
    left = git(wt, "status", "--porcelain", check=False).strip()
    if left:
        print("ofmutate: ВНИМАНИЕ, дерево не вернулось в исходное состояние:\n"
              + left, file=sys.stderr)
        return False
    return True


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("worktree")
    ap.add_argument("--test", required=True,
                    help="фильтр cargo test; пустой прогон считается отказом")
    ap.add_argument("--base", default=None,
                    help="база для сравнения; по умолчанию автодетект "
                         "(OFMUTATE_BASE, origin/HEAD, main, master — см. "
                         "default_base())")
    ap.add_argument("-p", "--crate", action="append", default=[])
    ap.add_argument("--per-hunk", action="store_true",
                    help="дополнительно откатить каждый ханк по одному")
    ap.add_argument("--dry-run", action="store_true",
                    help="только инвентарь ханков, ничего не запускать и не менять")
    a = ap.parse_args()

    # Прогон длится минуты. При перенаправлении в файл stdout блочно буферизуется,
    # и до конца работы не видно ни этапа, ни того, что инструмент вообще жив.
    sys.stdout.reconfigure(line_buffering=True)

    wt = os.path.abspath(a.worktree)
    if not os.path.isdir(wt):
        die(f"нет каталога: {wt}")

    # Цель отката доказывается ДО отката: дерево должно быть чистым, иначе
    # восстановление затрёт незакоммиченную работу.
    dirty = git(wt, "status", "--porcelain").strip()
    if dirty:
        die("рабочее дерево не чистое — откат ханков затёр бы эти изменения:\n"
            + dirty + "\n  закоммить или спрячь их и повтори", 2)

    if a.base is None:
        a.base = default_base(wt)
    git(wt, "rev-parse", "--verify", a.base)
    head = git(wt, "rev-parse", "HEAD").strip()
    if not git(wt, "diff", "--name-only", f"{a.base}...{head}").strip():
        die(f"HEAD не отличается от {a.base} — откатывать нечего", 2)

    hunks = split_hunks(wt, a.base, head)
    prod = [h for h in hunks if not h["test"]]
    tests = [h for h in hunks if h["test"]]

    print(f"# worktree {wt}")
    print(f"# HEAD {head[:9]}  база {a.base}  фильтр '{a.test}'")
    print(f"# ханков: {len(prod)} продакшн, {len(tests)} тестовых")
    for h in hunks:
        kind = "тест " if h["test"] else "прод "
        print(f"    {kind} {h['file']}  @@+{h['start']},{h['span']}")
    if not prod:
        die("продакшн-ханков нет — патч состоит из одних тестов, "
            "откатывать нечего", 2)
    if a.dry_run:
        return 0

    if free_gb() < DISK_MIN_G:
        die(f"свободно {free_gb()}G, целям сборки нужно ~{DISK_MIN_G}G. "
            "Это отказ инструмента, НЕ дефект патча: "
            "docker volume rm fang-target-<slug>", 3)

    logdir = tempfile.mkdtemp(prefix="ofmutate-")
    print(f"# логи: {logdir}")
    files = sorted({h["file"] for h in prod})

    # Том выбирается ОДИН раз на весь прогон: оба этапа обязаны идти на одном и том
    # же томе, иначе второй этап собирался бы с нуля и сравнивать было бы нечего.
    tgt, note = target_volume(wt)
    if note:
        print(f"# ofmutate: {note}")
    print(f"# том цели сборки: {tgt}")

    print("\n[1/2] как есть — обязано быть зелёным и непустым")
    g = run_tests(wt, a.crate, a.test, "green", logdir, tgt)
    show(g, "как есть")
    if g["verdict"] != "GREEN":
        print(f"\nОТКАЗ: с патчем тест не проходит ({g['verdict']}). "
              "Доказывать нечего.", file=sys.stderr)
        return 1
    if g["passed"] < 1:
        print(f"\nОТКАЗ: фильтр '{a.test}' не выбрал ни одного теста "
              "(passed=0). Зелёный пустой прогон — это тавтология, "
              "а не доказательство.", file=sys.stderr)
        return 4

    print(f"\n[2/2] продакшн-ханки откачены ({len(prod)} шт.) — обязано покраснеть")
    apply_reverse(wt, prod, logdir, "prod-revert")
    try:
        r = run_tests(wt, a.crate, a.test, "red-all", logdir, tgt)
    finally:
        ok = restore(wt, files)
    show(r, "без патча")

    per = []
    if a.per_hunk and len(prod) > 1:
        print(f"\n[+] по одному ханку ({len(prod)} прогонов)")
        for h in prod:
            apply_reverse(wt, [h], logdir, f"h{h['n']}-{os.path.basename(h['file'])}")
            try:
                rr = run_tests(wt, a.crate, a.test,
                               f"red-{h['file'].replace('/', '_')}-{h['n']}",
                               logdir, tgt)
            finally:
                restore(wt, [h["file"]])
            show(rr, f"{h['file']} @@+{h['start']}")
            per.append((h, rr))

    print("\n=== вердикт ===")
    if not ok:
        print("ДЕРЕВО НЕ ВОССТАНОВЛЕНО — разберись с этим раньше вердикта")
        return 6
    if r["verdict"] == "RED-ASSERT":
        print(f"ДОКАЗАНО (RED-ASSERT): с патчем {g['passed']} passed; без него "
              f"{r['failed']} failed. Тест смотрит на поведение патча.")
        rc = 0
    elif r["verdict"] == "RED-COMPILE":
        print("СЛАБОЕ КРАСНОЕ (RED-COMPILE): без патча тест не собирается. "
              "Доказано, что он знает о новом API, НЕ доказано, что проверяет "
              "его поведение. Нужен ещё один тест, падающий на утверждении, "
              "или --per-hunk.")
        rc = 0
    elif r["verdict"] == "GREEN":
        print(f"ТАВТОЛОГИЯ: без патча тест всё равно проходит "
              f"({r['passed']} passed). Тест не проверяет патч.")
        rc = 1
    else:
        print(f"НЕЯСНО ({r['verdict']}) — читай {r['log']} глазами")
        rc = 1
    for h, rr in per:
        if rr["verdict"] == "GREEN":
            print(f"  НЕ ПОКРЫТ: {h['file']} @@+{h['start']},{h['span']} — "
                  "тест не замечает откат этого ханка")
    print(f"логи прогонов: {logdir}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
