#!/bin/sh
# ofscrub — grep this skill's working tree for text that names ONE PARTICULAR
# install instead of the placeholders README.md promises.
#
# Why it exists: README.md says "Addresses and host names appear as <tailnet-ip>,
# <public-ip>, <tailnet-host> — substitute your own". That promise was broken by
# hand twice (a tailnet address and a relying-party domain landed in SKILL.md and
# scripts/README.md), because nothing checked it. Now something does.
#
#   ofscrub            # scan the skill tree this script lives in
#   ofscrub <dir>      # scan another tree
#   ofscrub --list     # print the rules and exit 0
#
# Exit codes: 0 clean · 1 at least one hit · 2 bad arguments.
#
# It REPORTS. It never edits a file.
#
# It skips .git/, __pycache__/, binary files, and its own source: the rules below
# contain the very strings they look for, so a scan that included this file would
# always find itself. That is the whole exemption — `grep -rn <pattern> . ` over
# everything else is exactly what runs.

set -eu

self_name=ofscrub

usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

root=""
case "${1:-}" in
    --list) list_only=1 ;;
    -h|--help) usage; exit 0 ;;
    "") list_only=0 ;;
    -*) echo "$self_name: unknown option: $1" >&2; exit 2 ;;
    *) list_only=0; root="$1" ;;
esac
[ "${list_only:-0}" = 1 ] || :

if [ -z "$root" ]; then
    here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    root=$(dirname -- "$here")
fi

# name | ERE to find | ERE of lines to forgive (empty = forgive nothing)
rules() {
    cat <<'RULES'
public domain of this install	moone\.dev	
retired host name	denis-openfang	
public IPv4 of this host	77\.90\.43\.8	
tailnet address literal (must be <tailnet-ip>)	100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}	100\.64\.0\.0/10|100\.100\.100\.200
MagicDNS host name (must be <tailnet-host>)	[A-Za-z0-9-]+\.ts\.net	
passkey slot name printed literally	"slot"[ ]*:[ ]*"[^<]	
relying-party id printed literally	rp_id[ ]*=[ ]*"[^<"]	\.(example|invalid|test)([:/][^"]*)?"
relying-party origin printed literally	rp_origin[ ]*=[ ]*"https://[^<"]	\.(example|invalid|test)([:/][^"]*)?"
RULES
}

if [ "${list_only:-0}" = 1 ]; then
    rules | while IFS='	' read -r name pat allow; do
        printf '%s\n    find:    %s\n' "$name" "$pat"
        [ -n "$allow" ] && printf '    forgive: %s\n' "$allow"
    done
    exit 0
fi

[ -d "$root" ] || { echo "$self_name: not a directory: $root" >&2; exit 2; }

echo "$self_name: scanning $root (skipping .git/, __pycache__/, $self_name itself)"
found=0
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT INT TERM

rules | while IFS='	' read -r name pat allow; do
    if [ -n "$allow" ]; then
        hits=$(grep -rnIE --exclude-dir=.git --exclude-dir=__pycache__ \
                   --exclude="$self_name" -- "$pat" "$root" 2>/dev/null \
               | grep -vE -- "$allow" || true)
    else
        hits=$(grep -rnIE --exclude-dir=.git --exclude-dir=__pycache__ \
                   --exclude="$self_name" -- "$pat" "$root" 2>/dev/null || true)
    fi
    if [ -n "$hits" ]; then
        printf 'HIT  %s\n' "$name"
        printf '%s\n' "$hits" | sed "s|^$root/|       |"
        echo 1 >> "$tmp"
    else
        printf 'ok   %s\n' "$name"
    fi
done

if [ -s "$tmp" ]; then
    echo "$self_name: FAIL — the placeholder promise in README.md is not true right now"
    exit 1
fi
echo "$self_name: clean"
exit 0
